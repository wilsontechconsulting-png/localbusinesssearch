---
import Seo from '@/components/Seo.astro';
import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
};

const { title, description, canonicalPath, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
