---
import { pageImages } from '@/data/pageImages';

type EnhancementCard = {
  title: string;
  body: string;
  href?: string;
};

type Enhancement = {
  eyebrow: string;
  title: string;
  intro: string;
  cards: EnhancementCard[];
  metrics?: { value: string; label: string }[];
  image?: string;
  imageAlt?: string;
};

const enhancements: Record<string, Enhancement> = {
  '/services/': {
    eyebrow: 'Growth Services',
    title: 'Business services now, with products and resources built into the direction.',
    intro:
      'The service mix is built around a simple business goal: help people find you, trust you, understand the offer, and take the next step.',
    cards: [
      {
        title: 'Marketing and advertising',
        body: 'Campaign strategy, Google, Meta, retargeting, local media, and campaign management connected to clear business offers.',
        href: '/advertising/',
      },
      {
        title: 'Websites and search visibility',
        body: 'Professional websites, local SEO, content structure, and technical cleanup that make the business easier to find and trust.',
        href: '/baselayer/',
      },
      {
        title: 'Tools, automation, and resources',
        body: 'CRM workflows, follow-up automation, practical consulting, recommended tools, and productized resources that support business owners.',
        href: '/business-operations/',
      },
    ],
    metrics: [
      { value: '01', label: 'Get found' },
      { value: '02', label: 'Explain offers' },
      { value: '03', label: 'Add resources' },
    ],
    image: pageImages.servicePlanning,
    imageAlt: 'Business team planning local growth strategy',
  },
  '/advertising/': {
    eyebrow: 'Paid Growth',
    title: 'Advertising works harder when every click has a job to do.',
    intro:
      'The campaign is only the front door. The lift comes from pairing media spend with stronger offers, better landing pages, useful content, and fast follow-up.',
    cards: [
      { title: 'Channel strategy', body: 'Google, paid social, programmatic, OTT, CTV, and retargeting planned around intent and local market fit.' },
      { title: 'Next-step path', body: 'Landing pages, forms, CRM routing, and follow-up designed before the campaign starts spending.' },
      { title: 'Resource support', body: 'Campaigns can be supported by guides, offers, product picks, and useful downloads that help buyers decide.' },
    ],
    image: pageImages.socialAdvertising,
    imageAlt: 'Paid social advertising shown on a smartphone',
  },
  '/baselayer/': {
    eyebrow: 'Professional Websites',
    title: 'A website should clarify the offer, build confidence, and make the next step obvious.',
    intro:
      'The site is where search traffic, paid clicks, referrals, and repeat visitors decide whether the business feels credible enough to contact.',
    cards: [
      { title: 'Clear positioning', body: 'Page structure, headlines, and calls to action explain what the company does and why it is the right choice.' },
      { title: 'Next-step paths', body: 'Forms, phone calls, contact pages, landing pages, and resource links guide visitors without making them hunt.' },
      { title: 'Resource foundation', body: 'Fast static pages, clean metadata, accessible structure, and useful content support long-term growth.' },
    ],
    image: pageImages.websiteWork,
    imageAlt: 'Team reviewing website and campaign work on laptops',
  },
  '/search-seo/': {
    eyebrow: 'Search & SEO',
    title: 'Search visibility is strongest when technical clarity and customer intent work together.',
    intro:
      'We improve the signals that help customers, search engines, and answer systems understand what the business does and when it should be recommended.',
    cards: [
      { title: 'Local discovery', body: 'Service-area clarity, internal links, technical cleanup, and location relevance help the right local customers find you.' },
      { title: 'Service authority', body: 'Pages answer the questions buyers ask before they compare, call, book, or request a quote.' },
      { title: 'Resource-ready structure', body: 'Search work supports articles, guides, recommendations, and pages that can grow into a broader resource library.' },
    ],
    image: pageImages.searchDashboard,
    imageAlt: 'Analytics dashboard for search visibility and performance',
  },
  '/business-operations/': {
    eyebrow: 'Business Systems',
    title: 'Better growth needs cleaner operations behind it.',
    intro:
      'We help connect marketing, lead handling, customer data, resources, and repeated work so owners can move with less friction.',
    cards: [
      { title: 'Owner clarity', body: 'A clear view of what is available, what is stuck, and where the next practical move should happen.' },
      { title: 'Resource organization', body: 'Services, tools, recommendations, and workflows can be organized instead of scattered across accounts.' },
      { title: 'COO execution', body: 'Response, booking, reminders, and handoffs handled consistently without adding busywork.' },
    ],
    image: pageImages.operationsDesk,
    imageAlt: 'Business team reviewing operational reports',
  },
  '/ai-automation/': {
    eyebrow: 'Automation',
    title: 'Automation should make the business faster, not make it feel less human.',
    intro:
      'Artificial intelligence is useful when it improves response time, consistency, research, analysis, or handoffs. It is one tool inside a broader growth system.',
    cards: [
      { title: 'Instant response', body: 'Missed calls and forms get a fast reply instead of waiting for someone to check a queue.' },
      { title: 'Smart routing', body: 'Qualified leads move to the right workflow, calendar, or team member with less manual sorting.' },
      { title: 'Follow-up memory', body: 'Nurture, reactivation, reminders, and review requests continue without relying on staff bandwidth.' },
    ],
    image: pageImages.automationDashboard,
    imageAlt: 'Automation dashboard on a laptop',
  },
  '/platform/': {
    eyebrow: 'Business Tools & Resources',
    title: 'A practical foundation for products, recommendations, downloads, and shop-style resources.',
    intro:
      'The platform direction is bigger than a services menu. It is a place for business owners to find services, recommended tools, useful guides, and digital resources.',
    cards: [
      { title: 'Recommended tools', body: 'Curated software, platforms, and services can be organized into useful recommendations for owners.' },
      { title: 'Digital downloads', body: 'Templates, checklists, guides, and productized resources can support businesses that are not ready for full service.' },
      { title: 'Shop-ready structure', body: 'The site can grow naturally into a marketplace-style resource layer without abandoning business services.' },
    ],
    image: pageImages.workflowAutomation,
    imageAlt: 'Automation workflow shown across devices',
  },
  '/results/': {
    eyebrow: 'Proof & Outcomes',
    title: 'Business growth improves when every stage of the customer path is connected.',
    intro:
      'The strongest gains usually come from improving more than one layer: visibility, credibility, useful content, services, resources, and follow-up.',
    cards: [
      { title: 'Visibility', body: 'Search and advertising put the business in front of more qualified prospects.' },
      { title: 'Trust', body: 'Websites, offers, resources, and follow-up help prospects understand why the business is worth contacting.' },
      { title: 'Resources', body: 'Guides, recommendations, and productized tools give owners more ways to get help.' },
    ],
    image: pageImages.marketingAnalytics,
    imageAlt: 'Marketing analytics on a smartphone',
  },
  '/about/': {
    eyebrow: 'About Local Business Search',
    title: 'Built for business owners who want modern marketing without needless complexity.',
    intro:
      'The work combines strategy, creative, websites, advertising, automation, software, resources, and practical consulting into one growth system.',
    cards: [
      { title: 'Business-first', body: 'The recommendation starts with the growth problem, not with a favorite platform or trend.' },
      { title: 'Technology-aware', body: 'Modern tools, including AI, are used where they improve speed, clarity, and execution.' },
      { title: 'Resource-minded', body: 'The long-term direction includes products, recommendations, guides, and useful business tools.' },
    ],
    image: pageImages.strategyMeeting,
    imageAlt: 'Business team collaborating around a strategy board',
  },
  '/industries/': {
    eyebrow: 'Industry Fit',
    title: 'Different markets lose opportunities in different places.',
    intro:
      'The system changes by business type, but the goal is consistent: stronger visibility, faster response, useful resources, and cleaner execution.',
    cards: [
      { title: 'Home Services', body: 'Missed call recovery, job booking, reminders, and practical owner resources.', href: '/industries/home-services/' },
      { title: 'Medical', body: 'New patient response, appointment reminders, reactivation, and clear service information.', href: '/industries/medical/' },
      { title: 'Legal', body: 'Case intake, qualification, consultation scheduling, and trust-building content.', href: '/industries/legal/' },
      { title: 'Local Retail', body: 'Customer retention, loyalty, reviews, events, and repeat-visit campaigns.', href: '/industries/local-retail/' },
      { title: 'Franchises', body: 'Location routing, campaign consistency, resource libraries, and multi-location rollout.', href: '/industries/franchises/' },
      { title: 'Municipalities', body: 'Public messaging, resident engagement, event promotion, and budget-conscious communication.', href: '/industries/municipalities/' },
    ],
    image: pageImages.localStorefront,
    imageAlt: 'Independent local storefront',
  },
};

const industryEnhancements: Record<string, Enhancement> = {
  '/industries/home-services/': {
    eyebrow: 'Home Services',
    title: 'Capture the call, book the job, and show which work came from which spend.',
    intro: 'Built for operators who are often in the field when the next high-intent lead comes in.',
    cards: [
      { title: 'Missed call recovery', body: 'A fast text and booking path keeps job opportunities from disappearing while the team is busy.' },
      { title: 'Scheduling flow', body: 'Direct booking and reminders reduce phone tag, no-shows, and wasted dispatch time.' },
      { title: 'Job-level support', body: 'Advertising, booking, reminders, and follow-up can support the work from first inquiry through completed job.' },
    ],
    image: pageImages.homeServiceTech,
    imageAlt: 'Home service technician working on site',
  },
  '/industries/medical/': {
    eyebrow: 'Medical & Healthcare',
    title: 'Protect the schedule and bring patient demand into a measurable system.',
    intro: 'Designed around patient response, booking discipline, reactivation, and careful data handling.',
    cards: [
      { title: 'New patient response', body: 'Inquiries get a fast path to booking before attention moves to another provider.' },
      { title: 'No-show control', body: 'Reminder and follow-up sequences protect schedules and reduce wasted staff time.' },
      { title: 'Reactivation', body: 'Inactive patients can be brought back with structured, compliant communication workflows.' },
    ],
    image: pageImages.medicalOffice,
    imageAlt: 'Doctor consulting with a patient in a medical office',
  },
  '/industries/legal/': {
    eyebrow: 'Legal',
    title: 'Move good cases from inquiry to consultation before another firm answers.',
    intro: 'Built for intake speed, qualification, attorney focus, and clearer ROI by practice area.',
    cards: [
      { title: 'Case qualification', body: 'Screening questions help route high-value matters without burning attorney time.' },
      { title: 'Consultation booking', body: 'Qualified leads can move straight to an available calendar instead of waiting on callbacks.' },
      { title: 'Retainer visibility', body: 'Signed cases, unsigned cases, and marketing sources become easier to compare.' },
    ],
    image: pageImages.legalJustice,
    imageAlt: 'Legal and justice symbol for law firm intake',
  },
  '/industries/local-retail/': {
    eyebrow: 'Local Retail',
    title: 'Turn one-time visits into repeat behavior you can actually measure.',
    intro: 'The focus is retention, reviews, events, loyalty, and customer lifetime value.',
    cards: [
      { title: 'Win-back campaigns', body: 'Timed offers bring inactive customers back without manual list work.' },
      { title: 'Loyalty automation', body: 'Digital rewards, birthdays, and visit-based triggers replace fragile punch-card systems.' },
      { title: 'Event lift', body: 'Promotions for menus, sales, classes, or openings reach the customers most likely to act.' },
    ],
    image: pageImages.localRetail,
    imageAlt: 'Independent local storefront',
  },
  '/industries/franchises/': {
    eyebrow: 'Franchises',
    title: 'Central control with local execution for every location.',
    intro: 'Built for owners who need consistency, comparison, and scalable rollout across multiple markets.',
    cards: [
      { title: 'Location intelligence', body: 'Performance by location becomes visible in one place, not scattered across accounts.' },
      { title: 'Routing rules', body: 'Leads move to the nearest or best-fit location with consistent workflows.' },
      { title: 'Reusable playbooks', body: 'What works in one market can be deployed across the system faster.' },
    ],
    image: pageImages.franchiseStorefront,
    imageAlt: 'Franchise storefront and signage',
  },
  '/industries/municipalities/': {
    eyebrow: 'Municipalities',
    title: 'Reach residents with measurable communication instead of hoping posts get seen.',
    intro: 'Built for public service messaging, events, engagement, and budget-conscious outreach.',
    cards: [
      { title: 'Public messages', body: 'Important service updates can reach residents beyond organic social reach.' },
      { title: 'Event attendance', body: 'Town halls, festivals, meetings, and programs get targeted promotion and tracking.' },
      { title: 'Resident feedback', body: 'Surveys, registrations, and follow-up loops make engagement easier to manage.' },
    ],
    image: pageImages.municipalBuilding,
    imageAlt: 'Municipal building with public signage',
  },
};

type Props = {
  path: string;
};

const { path } = Astro.props;
const enhancement = enhancements[path] ?? industryEnhancements[path];
---

{
  enhancement && (
    <section class="page-enhancement" aria-label={`${enhancement.eyebrow} overview`}>
      <div class="container enhancement-shell">
        <div class:list={['enhancement-top', !enhancement.image && 'enhancement-top-single']}>
          <div class="enhancement-header">
            <p class="hero-kicker">{enhancement.eyebrow}</p>
            <h2>{enhancement.title}</h2>
            <p>{enhancement.intro}</p>
          </div>
          {enhancement.image && (
            <figure class="enhancement-image">
              <img src={enhancement.image} alt={enhancement.imageAlt ?? ''} loading="lazy" />
            </figure>
          )}
        </div>
        {enhancement.metrics && (
          <div class="enhancement-metrics" aria-label="System sequence">
            {enhancement.metrics.map((metric) => (
              <div>
                <span>{metric.value}</span>
                <p>{metric.label}</p>
              </div>
            ))}
          </div>
        )}
        <div class:list={['enhancement-grid', enhancement.cards.length > 3 && 'enhancement-grid-wide']}>
          {enhancement.cards.map((card) => {
            const content = (
              <>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </>
            );
            return card.href ? (
              <a class="enhancement-card" href={card.href}>
                {content}
              </a>
            ) : (
              <div class="enhancement-card">
                {content}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
