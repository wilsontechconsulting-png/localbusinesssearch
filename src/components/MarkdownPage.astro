---
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<article class="markdown-page">
  <section class="page-hero">
    <div class="container">
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
  </section>
  <div class="container prose">
    <slot />
  </div>
</article>
