---
import { mainNav } from '@/data/site';
import PageEnhancement from './PageEnhancement.astro';

type Props = {
  title: string;
  description?: string;
  path?: string;
};

const { title, description, path = '/' } = Astro.props;
const internalNav = mainNav.flatMap((item) => item.children ?? []).filter((item) => !item.external);
const currentItem = internalNav.find((item) => item.href.split('?')[0] === path);
const relatedLinks = currentItem?.group
  ? internalNav.filter((item) => item.group === currentItem.group && !item.href.includes('?'))
  : [];

type HeroDesign = {
  eyebrow: string;
  headline?: string;
  subheadline?: string;
  image: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  proof?: string[];
};

const defaultHero: HeroDesign = {
  eyebrow: currentItem?.group ?? 'Local Business Search',
  image: '/images/blog/seo-llm-2026.jpg',
  ctaLabel: 'Request a Consultation',
  ctaHref: '/contact/',
  secondaryLabel: 'Explore Services',
  secondaryHref: '/services/',
  proof: ['Strategy', 'Execution', 'Resources'],
};

const heroDesigns: Record<string, HeroDesign> = {
  '/services/': {
    eyebrow: 'Growth Services',
    headline: 'Business growth services with room to expand into tools, products, and resources.',
    subheadline:
      'We connect marketing, websites, search visibility, advertising, automation, and consulting while building toward a practical resource ecosystem for business owners.',
    image: '/images/blog/seo-llm-2026.jpg',
    proof: ['Digital marketing', 'Websites', 'Automation'],
  },
  '/baselayer/': {
    eyebrow: 'Professional Websites',
    headline: 'A better website should make the business easier to trust and easier to contact.',
    subheadline:
      'We build fast, credible pages that explain the offer, support search visibility, and make the next step clear for visitors.',
    image: '/images/lbs-icon.jpg',
    proof: ['Clear offers', 'Fast pages', 'Useful content'],
  },
  '/search-seo/': {
    eyebrow: 'Search & SEO',
    headline: 'Get found by the people already looking for what you sell.',
    subheadline:
      'Local SEO, technical search structure, service pages, and answer-ready content built around real customer intent.',
    image: '/images/blog/seo-llm-2026.jpg',
    proof: ['Local discovery', 'Service pages', 'Search clarity'],
  },
  '/advertising/': {
    eyebrow: 'Paid Advertising',
    headline: 'Campaigns built around clear offers, useful pages, and practical follow-up.',
    subheadline:
      'We pair paid media with stronger messaging, landing pages, audience strategy, and business support that keeps campaigns grounded.',
    image: '/images/pizza-world-branson-campaign-preview.png',
    proof: ['Google', 'Social', 'Retargeting'],
  },
  '/business-operations/': {
    eyebrow: 'Business Software',
    headline: 'Cleaner systems behind the growth so fewer opportunities slip through.',
    subheadline:
      'CRM workflows, lead routing, reminders, resource organization, and operational tools that make marketing easier to manage.',
    image: '/images/triple-crown-logo.jpg',
    proof: ['CRM workflows', 'Lead routing', 'Owner visibility'],
  },
  '/ai-automation/': {
    eyebrow: 'Automation',
    headline: 'Automation that improves speed and consistency without making the business feel robotic.',
    subheadline:
      'AI is one tool in the system. We use it where it improves response, research, analysis, and follow-up.',
    image: '/images/blog/lead-follow-up-field-note.jpg',
    proof: ['Fast response', 'Better handoffs', 'Smarter follow-up'],
  },
  '/platform/': {
    eyebrow: 'Business Tools & Resources',
    headline: 'A foundation for useful business tools, recommendations, downloads, and resources.',
    subheadline:
      'The platform direction is a practical hub for business owners: service support today, productized resources and curated recommendations next.',
    image: '/images/pizza-world-cross-creek-location.jpg',
    proof: ['Tools', 'Guides', 'Recommendations'],
  },
  '/industries/': {
    eyebrow: 'Industries',
    headline: 'Growth systems for businesses where missed opportunities are expensive.',
    subheadline:
      'Different markets need different playbooks, but every business needs stronger visibility, faster response, and useful resources that support the work.',
    image: '/images/blog/seo-llm-2026.jpg',
    proof: ['Home services', 'Medical', 'Legal'],
  },
  '/results/': {
    eyebrow: 'Proof & Outcomes',
    headline: 'The work is built around better visibility, stronger offers, and practical next steps.',
    subheadline:
      'Momentum comes from connecting the full path: visibility, credibility, useful resources, follow-up, and consistent execution.',
    image: '/images/pizza-world-branson-campaign-preview.png',
    proof: ['Visibility', 'Trust', 'Momentum'],
  },
  '/about/': {
    eyebrow: 'About',
    headline: 'A business growth partner built for owners who want practical execution.',
    subheadline:
      'Local Business Search blends marketing strategy, websites, automation, software, consulting, and practical resources into a clearer growth system.',
    image: '/images/lbs-icon.jpg',
    proof: ['Practical', 'Modern', 'Accountable'],
  },
  '/contact/': {
    eyebrow: 'Contact',
    headline: 'Start with a clear conversation about where growth is getting stuck.',
    subheadline:
      'Tell us what you are trying to improve. We can talk through services available now and the tools or resources that would help next.',
    image: '/images/blog/seo-llm-2026.jpg',
    ctaLabel: 'Send a Message',
    ctaHref: 'mailto:jed@powerofadvertising.com',
    secondaryLabel: 'View Services',
    secondaryHref: '/services/',
    proof: ['No pressure', 'Plain English', 'Next steps'],
  },
  '/demo/': {
    eyebrow: 'Demo',
    headline: 'See how a clearer growth system would work for your business.',
    subheadline:
      'A demo is a focused walkthrough of the service support, resource structure, and practical tools your business may need.',
    image: '/images/blog/lead-follow-up-field-note.jpg',
    proof: ['Website', 'Services', 'Resources'],
  },
  '/privacy-policy/': {
    eyebrow: 'Privacy',
    headline: 'Plain-language privacy information for visitors, prospects, and clients.',
    subheadline: 'How we handle contact details, analytics, communication data, and service-related information.',
    image: '/images/lbs-icon.jpg',
    secondaryLabel: 'Contact Us',
    secondaryHref: '/contact/',
    proof: ['No data sales', 'Trusted tools', 'Clear use'],
  },
  '/terms/': {
    eyebrow: 'Terms',
    headline: 'General terms for using the Local Business Search website.',
    subheadline: 'A straightforward explanation of website use, service expectations, and performance disclosures.',
    image: '/images/lbs-icon.jpg',
    secondaryLabel: 'Contact Us',
    secondaryHref: '/contact/',
    proof: ['Clear scope', 'Written work', 'No guarantees'],
  },
};

const industryHero = path.startsWith('/industries/')
  ? {
      eyebrow: currentItem?.name ?? 'Industry Growth Systems',
      headline: `${title} growth systems built around visibility, response, and follow-through.`,
      subheadline:
        description ??
        'A practical blend of search visibility, websites, advertising, automation, and business resources for this market.',
      image: path.includes('local-retail') || path.includes('franchises') || path.includes('municipalities')
        ? '/images/pizza-world-cross-creek-location.jpg'
        : '/images/blog/lead-follow-up-field-note.jpg',
      proof: ['Get found', 'Respond faster', 'Grow smarter'],
    }
  : undefined;

const design: HeroDesign = { ...defaultHero, ...(heroDesigns[path] ?? industryHero ?? {}) };
const heroHeadline = design.headline ?? title;
const heroSubheadline = design.subheadline ?? description;
---

<article class="markdown-page">
  <section class="page-hero page-hero-professional" style={`--hero-image: url('${design.image}')`}>
    <div class="container page-hero-grid">
      <div class="page-hero-copy">
        <p class="hero-kicker">{design.eyebrow}</p>
        <h1>{heroHeadline}</h1>
        {heroSubheadline && <p>{heroSubheadline}</p>}
        <div class="page-hero-actions">
          {design.ctaLabel && design.ctaHref && <a class="hero-button hero-button-primary" href={design.ctaHref}>{design.ctaLabel}</a>}
          {design.secondaryLabel && design.secondaryHref && <a class="hero-button hero-button-secondary" href={design.secondaryHref}>{design.secondaryLabel}</a>}
        </div>
      </div>
      <div class="page-hero-panel" aria-label={`${design.eyebrow} highlights`}>
        <img src={design.image} alt="" loading="eager" />
        <div class="page-hero-proof">
          {(design.proof ?? []).map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </section>
  <PageEnhancement path={path} />
  <div class:list={['container', 'content-shell', relatedLinks.length <= 1 && 'content-shell-wide']}>
    {
      relatedLinks.length > 1 && (
        <aside class="content-aside" aria-label={`${currentItem?.group} navigation`}>
          <p>{currentItem?.group}</p>
          <nav>
            {relatedLinks.map((link) => (
              <a href={link.href} class:list={[link.href === path && 'active']}>{link.name}</a>
            ))}
          </nav>
        </aside>
      )
    }
    <div class="prose content-body">
      <slot />
    </div>
  </div>
  {
    currentItem && path !== '/contact/' && (
      <section class="container content-cta" aria-label="Next step">
        <div>
          <p>Ready to grow with more clarity?</p>
          <h2>Build a practical plan for your services, website, marketing, and resource system.</h2>
        </div>
        <a href="/contact/">Request a Consultation</a>
      </section>
    )
  }
</article>
