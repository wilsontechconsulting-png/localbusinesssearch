---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { getCollection, getEntry } from 'astro:content';
import { postDateSort } from '@/utils/content';

const entry = await getEntry('pages', '_index');
if (!entry) throw new Error('Missing homepage content');
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(postDateSort).slice(0, 3);

const systems = [
  {
    title: 'Lead Response',
    text: 'Capture, route, and follow up before good prospects cool off.',
    href: '/ai-automation/',
  },
  {
    title: 'Advertising Intelligence',
    text: 'Connect spend, source, and performance so campaigns feed decisions.',
    href: '/advertising/',
  },
  {
    title: 'Business Operations',
    text: 'Turn scattered tools into workflows owners can actually trust.',
    href: '/business-operations/',
  },
];

const industries = [
  ['Home Services', '/industries/home-services/'],
  ['Medical', '/industries/medical/'],
  ['Legal', '/industries/legal/'],
  ['Local Retail', '/industries/local-retail/'],
  ['Franchises', '/industries/franchises/'],
  ['Municipalities', '/industries/municipalities/'],
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI. Business Process.</p>
        <h1>AI-driven business systems for local companies</h1>
        <p>
          We connect advertising, lead follow-up, customer operations, and owner visibility into
          systems that help local businesses move faster with less waste.
        </p>
        <div class="hero-actions">
          <a href="/demo/" class="btn primary">Book a Demo</a>
          <a href="/platform/" class="btn secondary">See the Platform</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Local Business Search operating model">
        <div class="panel-logo">
          <img src="/images/lbs-logo.jpg" alt="Local Business Search" />
        </div>
        <div class="signal-list">
          <div><span>01</span><strong>Traffic</strong><small>Google, Meta, CTV, organic</small></div>
          <div><span>02</span><strong>Follow-up</strong><small>Speed, routing, automation</small></div>
          <div><span>03</span><strong>Operations</strong><small>CRM, reporting, workflows</small></div>
          <div><span>04</span><strong>Decisions</strong><small>Plain-English action alerts</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="systems-section">
    <div class="container section-heading">
      <p class="eyebrow">Core Systems</p>
      <h2>Built around the places local businesses leak money</h2>
    </div>
    <div class="container system-grid">
      {systems.map((system) => (
        <a href={system.href} class="system-card">
          <h3>{system.title}</h3>
          <p>{system.text}</p>
          <span>Open</span>
        </a>
      ))}
    </div>
  </section>

  <section class="operator-band">
    <div class="container operator-grid">
      <div>
        <p class="eyebrow">Operator View</p>
        <h2>A website, a workflow, and a watchdog should work together</h2>
      </div>
      <p>
        The site explains the offer. The workflow handles the lead. The watchdog catches what
        owners normally find weeks too late.
      </p>
    </div>
  </section>

  <section class="industries-section">
    <div class="container section-heading">
      <p class="eyebrow">Markets</p>
      <h2>Configured for real local business categories</h2>
    </div>
    <div class="container industry-list">
      {industries.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
  </section>

  <section class="latest-section">
    <div class="container section-heading split">
      <div>
        <p class="eyebrow">Latest Thinking</p>
        <h2>Field notes on AI, advertising, and business systems</h2>
      </div>
      <a href="/blog/">All Articles</a>
    </div>
    <PostList posts={latestPosts} />
  </section>
</BaseLayout>

<style>
  .home-hero {
    background:
      linear-gradient(135deg, rgba(10, 22, 40, 0.96), rgba(10, 22, 40, 0.86)),
      radial-gradient(circle at 80% 10%, rgba(0, 102, 255, 0.22), transparent 34%);
    color: white;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .hero-grid,
  .operator-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.75fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: #2fbf71;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    letter-spacing: 0;
  }

  h1 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.6rem);
    line-height: 0.92;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    border-radius: 0.375rem;
    padding: 0 1rem;
    font-weight: 900;
    text-decoration: none;
  }

  .btn.primary {
    background: var(--blue);
    color: white;
  }

  .btn.secondary {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: white;
  }

  .hero-panel {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    padding: 1rem;
  }

  .panel-logo {
    border-radius: 0.375rem;
    background: white;
    padding: 1rem;
  }

  .signal-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .signal-list div {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 0.25rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.375rem;
    padding: 0.85rem;
  }

  .signal-list span {
    grid-row: span 2;
    color: #2fbf71;
    font-weight: 900;
  }

  .signal-list small {
    color: rgba(255, 255, 255, 0.68);
  }

  .systems-section,
  .industries-section,
  .latest-section {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading.split {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .section-heading h2,
  .operator-grid h2 {
    max-width: 800px;
    margin: 0;
    color: var(--navy);
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1;
  }

  .section-heading a {
    color: var(--blue);
    font-weight: 900;
    text-decoration: none;
  }

  .system-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .system-card {
    display: grid;
    min-height: 260px;
    align-content: space-between;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: white;
    padding: 1.25rem;
    text-decoration: none;
  }

  .system-card h3 {
    margin: 0;
    color: var(--navy);
    font-size: 1.45rem;
  }

  .system-card p {
    color: var(--muted);
    line-height: 1.65;
  }

  .system-card span {
    color: var(--blue);
    font-weight: 900;
  }

  .operator-band {
    background: #eef4ff;
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  .operator-grid p:not(.eyebrow) {
    color: var(--muted);
    font-size: 1.18rem;
    line-height: 1.75;
  }

  .industry-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .industry-list a {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    padding: 0.75rem 1rem;
    color: var(--navy);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .operator-grid,
    .system-grid {
      grid-template-columns: 1fr;
    }

    .section-heading.split {
      display: grid;
    }
  }
</style>
