---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { getCollection, getEntry } from 'astro:content';
import { postDateSort } from '@/utils/content';

const entry = await getEntry('pages', '_index');
if (!entry) throw new Error('Missing homepage content');
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(postDateSort).slice(0, 3);

const services = [
  {
    title: 'Digital marketing',
    text: 'Campaign strategy, channel planning, creative direction, and performance management built around revenue outcomes.',
    href: '/services/',
  },
  {
    title: 'Search visibility',
    text: 'Local SEO, content structure, technical cleanup, and answer-ready pages that help customers find and trust you.',
    href: '/search-seo/',
  },
  {
    title: 'Websites that convert',
    text: 'Fast, credible websites with clear offers, stronger calls to action, and the tracking needed to improve them.',
    href: '/baselayer/',
  },
  {
    title: 'Paid advertising',
    text: 'Google, social, retargeting, CTV, and local media connected to landing pages, lead routing, and source reporting.',
    href: '/advertising/',
  },
  {
    title: 'Automation and software',
    text: 'Practical systems for follow-up, CRM workflows, reporting, scheduling, and repeated work that should not stay manual.',
    href: '/business-operations/',
  },
  {
    title: 'Consulting and analytics',
    text: 'A clearer operating view of what is working, where money is leaking, and what to fix next.',
    href: '/platform/',
  },
];

const proofPoints = [
  'Marketing strategy tied to follow-up and conversion',
  'Modern websites built to support paid and organic growth',
  'Automation used where it improves speed and consistency',
  'Plain-English reporting owners can act on',
];

const industries = [
  ['Home Services', '/industries/home-services/'],
  ['Medical', '/industries/medical/'],
  ['Legal', '/industries/legal/'],
  ['Local Retail', '/industries/local-retail/'],
  ['Franchises', '/industries/franchises/'],
  ['Municipalities', '/industries/municipalities/'],
];
---

<BaseLayout title="Local Business Search - Business Growth Partner" description="Local Business Search helps businesses grow with digital marketing, search visibility, websites, advertising, automation, analytics, and consulting." canonicalPath="/">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Marketing, websites, automation, and analytics</p>
        <h1>Business growth systems for companies ready to compete.</h1>
        <p>
          Local Business Search helps businesses turn visibility into revenue with sharper marketing,
          stronger websites, cleaner follow-up, and reporting that shows what to do next.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn primary">Request a Consultation</a>
          <a href="/services/" class="btn secondary">Explore Services</a>
        </div>
        <dl class="hero-trust" aria-label="Growth system focus areas">
          <div><dt>Traffic</dt><dd>Search, ads, content</dd></div>
          <div><dt>Conversion</dt><dd>Websites, offers, follow-up</dd></div>
          <div><dt>Clarity</dt><dd>Analytics, reporting, strategy</dd></div>
        </dl>
      </div>

      <div class="hero-showcase" aria-label="Local Business Search growth system preview">
        <div class="showcase-card brand-card">
          <img src="/images/lbs-logo.jpg" alt="Local Business Search brand mark" />
        </div>
        <div class="showcase-card performance-card">
          <p>Growth System</p>
          <div class="metric-row"><span>Search visibility</span><strong>High intent</strong></div>
          <div class="metric-row"><span>Paid media</span><strong>Measurable</strong></div>
          <div class="metric-row"><span>Follow-up</span><strong>Same day</strong></div>
          <div class="metric-row"><span>Reporting</span><strong>Owner-ready</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-band" aria-label="Trust indicators">
    <div class="container trust-grid">
      <p>Built for business owners who need more than vendor reports.</p>
      <span>Strategy</span>
      <span>Execution</span>
      <span>Automation</span>
      <span>Accountability</span>
    </div>
  </section>

  <section class="growth-section">
    <div class="container split-section">
      <div class="section-copy">
        <p class="eyebrow">What We Do</p>
        <h2>We connect the pieces that usually get managed separately.</h2>
        <p>
          Most businesses do not have a traffic problem by itself. They have a visibility,
          credibility, response, and measurement problem. We build the marketing and technology
          layer that helps those pieces work together.
        </p>
      </div>
      <figure class="image-frame">
        <img src="/images/social-card-default.png" alt="Local Business Search growth systems overview" loading="lazy" />
        <figcaption>Advertising, automation, operations, and revenue visibility working as one system.</figcaption>
      </figure>
    </div>
  </section>

  <section class="services-section">
    <div class="container section-heading split">
      <div>
        <p class="eyebrow">Services</p>
        <h2>Growth work that business owners can understand and measure.</h2>
      </div>
      <a href="/services/">View all services</a>
    </div>
    <div class="container service-grid">
      {services.map((service) => (
        <a href={service.href} class="service-card">
          <span aria-hidden="true"></span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="proof-section">
    <div class="container proof-grid">
      <div class="proof-media">
        <img src="/images/pizza-world-branson-campaign-preview.png" alt="Example local restaurant campaign creative" loading="lazy" />
        <img src="/images/pizza-world-cross-creek-location.jpg" alt="Local business storefront example" loading="lazy" />
      </div>
      <div class="section-copy">
        <p class="eyebrow">Why It Works</p>
        <h2>Strong marketing still depends on trust, speed, and follow-through.</h2>
        <p>
          We use creative, search, paid media, websites, software, and automation with one standard:
          will this help the business earn more opportunities and handle them better?
        </p>
        <ul class="check-list">
          {proofPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="operator-band">
    <div class="container operator-grid">
      <div>
        <p class="eyebrow">Modern Technology, Practical Use</p>
        <h2>AI is part of the toolkit. Growth is the product.</h2>
      </div>
      <p>
        We use artificial intelligence where it improves research, response, automation, analysis,
        or speed. The client-facing promise stays simple: better marketing, better systems, and
        clearer decisions.
      </p>
    </div>
  </section>

  <section class="industries-section">
    <div class="container split-section reverse">
      <div class="section-copy">
        <p class="eyebrow">Industries</p>
        <h2>Designed for businesses where missed opportunities are expensive.</h2>
        <p>
          The playbook changes by market, but the goal stays the same: get found, earn trust,
          respond faster, and know what is actually driving growth.
        </p>
        <div class="industry-list">
          {industries.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
      <figure class="image-frame">
        <img src="/images/blog/lead-follow-up-field-note.jpg" alt="Lead follow-up comparison for local businesses" loading="lazy" />
        <figcaption>Lead response and follow-up are growth systems, not back-office details.</figcaption>
      </figure>
    </div>
  </section>

  <section class="latest-section">
    <div class="container section-heading split">
      <div>
        <p class="eyebrow">Resources</p>
        <h2>Field notes on marketing, websites, operations, and smarter growth.</h2>
      </div>
      <a href="/blog/">All Articles</a>
    </div>
    <PostList posts={latestPosts} />
  </section>

  <section class="final-cta">
    <div class="container final-cta-grid">
      <div>
        <p class="eyebrow">Next Step</p>
        <h2>Bring your marketing, website, and follow-up into one growth plan.</h2>
      </div>
      <a href="/contact/" class="btn primary">Start the Conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(7, 17, 31, 0.98), rgba(13, 37, 68, 0.94)),
      url('/images/social-card-default.png') center / cover;
    color: white;
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3.5rem, 7vw, 6rem);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 17, 31, 0.95) 0%, rgba(7, 17, 31, 0.86) 46%, rgba(7, 17, 31, 0.54) 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 38%);
    content: '';
  }

  .hero-grid,
  .trust-grid,
  .split-section,
  .proof-grid,
  .operator-grid,
  .final-cta-grid {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1.04fr) minmax(340px, 0.78fr);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    letter-spacing: 0;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.94;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 0.45rem;
    padding: 0 1.1rem;
    font-weight: 900;
    text-decoration: none;
  }

  .btn.primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 16px 34px rgba(0, 102, 255, 0.28);
  }

  .btn.secondary {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: white;
  }

  .hero-trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 760px;
    margin: 2rem 0 0;
  }

  .hero-trust div,
  .showcase-card,
  .image-frame,
  .service-card {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.75rem;
  }

  .hero-trust div {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.9rem;
  }

  .hero-trust dt {
    font-weight: 900;
  }

  .hero-trust dd {
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.9rem;
  }

  .hero-showcase {
    display: grid;
    gap: 1rem;
  }

  .showcase-card {
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }

  .brand-card {
    background: white;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .brand-card img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }

  .performance-card {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .performance-card > p {
    margin: 0 0 0.25rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.8rem 0.9rem;
  }

  .metric-row span {
    color: rgba(255, 255, 255, 0.74);
  }

  .metric-row strong {
    color: white;
  }

  .trust-band {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .trust-grid {
    grid-template-columns: minmax(260px, 1fr) repeat(4, auto);
    align-items: center;
    padding-block: 1rem;
  }

  .trust-grid p {
    margin: 0;
    color: var(--muted);
    font-weight: 800;
  }

  .trust-grid span {
    color: var(--navy);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .growth-section,
  .services-section,
  .proof-section,
  .industries-section,
  .latest-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
  }

  .split-section,
  .proof-grid,
  .operator-grid,
  .final-cta-grid {
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.82fr);
    align-items: center;
  }

  .split-section.reverse {
    grid-template-columns: minmax(320px, 0.82fr) minmax(0, 0.95fr);
  }

  .split-section.reverse .section-copy {
    order: 2;
  }

  .split-section.reverse .image-frame {
    order: 1;
  }

  .section-copy h2,
  .section-heading h2,
  .operator-grid h2,
  .final-cta h2 {
    max-width: 860px;
    margin: 0;
    color: var(--navy);
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1;
  }

  .section-copy p:not(.eyebrow),
  .operator-grid p:not(.eyebrow) {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .image-frame {
    overflow: hidden;
    border-color: var(--line);
    background: white;
    margin: 0;
    box-shadow: 0 24px 70px rgba(10, 22, 40, 0.1);
  }

  .image-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .image-frame figcaption {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    padding: 1rem;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading.split {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .section-heading a {
    color: var(--blue);
    font-weight: 900;
    text-decoration: none;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-card {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-height: 270px;
    border-color: var(--line);
    background: white;
    padding: 1.25rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .service-card:hover {
    border-color: rgba(0, 102, 255, 0.38);
    box-shadow: 0 18px 44px rgba(10, 22, 40, 0.08);
    transform: translateY(-2px);
  }

  .service-card span {
    width: 2.5rem;
    height: 0.25rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--blue), var(--accent));
  }

  .service-card h3 {
    margin: 0;
    color: var(--navy);
    font-size: 1.32rem;
    line-height: 1.15;
  }

  .service-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .proof-section {
    background: var(--surface-subtle);
  }

  .proof-media {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 1rem;
    align-items: end;
  }

  .proof-media img {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    object-fit: cover;
    box-shadow: 0 24px 64px rgba(10, 22, 40, 0.1);
  }

  .proof-media img + img {
    transform: translateY(2rem);
  }

  .check-list {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .check-list li {
    position: relative;
    color: var(--ink);
    font-weight: 800;
    line-height: 1.5;
    padding-left: 1.75rem;
  }

  .check-list li::before {
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--accent);
    content: '';
  }

  .operator-band,
  .final-cta {
    background: var(--navy);
    color: white;
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
  }

  .operator-band h2,
  .final-cta h2 {
    color: white;
  }

  .operator-grid p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.76);
  }

  .industry-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .industry-list a {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    padding: 0.75rem 1rem;
    color: var(--navy);
    font-weight: 900;
    text-decoration: none;
  }

  .final-cta {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .final-cta-grid {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .split-section,
    .split-section.reverse,
    .proof-grid,
    .operator-grid,
    .service-grid,
    .final-cta-grid,
    .trust-grid {
      grid-template-columns: 1fr;
    }

    .split-section.reverse .section-copy,
    .split-section.reverse .image-frame {
      order: initial;
    }

    .section-heading.split {
      display: grid;
    }

    .trust-grid {
      gap: 0.75rem;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      padding: 3.5rem 0 3rem;
    }

    .home-hero .container {
      width: min(calc(100% - 2rem), 358px);
    }

    h1 {
      font-size: clamp(2.7rem, 13vw, 3.35rem);
      line-height: 0.98;
    }

    .hero-trust,
    .proof-media {
      grid-template-columns: 1fr;
    }

    .proof-media img + img {
      transform: none;
    }

    .btn {
      width: 100%;
    }
  }
</style>
