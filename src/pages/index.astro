---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarkdownPage from '@/components/MarkdownPage.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', '_index');
if (!entry) throw new Error('Missing homepage content');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/">
  <MarkdownPage title={entry.data.title} description={entry.data.description}>
    <Content />
  </MarkdownPage>
</BaseLayout>
